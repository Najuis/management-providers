# Copia este archivo a `.env` y ajusta los valores antes de ejecutar.
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="cambia_esto_por_una_clave_segura"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=40

## Solo necesario si quieres usar Postgres (define DATABASE_URL en el entorno)
#PG_HOST=""
#PG_PORT=""
#PG_DATABASE=""
#PG_USER=""
#PG_DB_PASSWORD=""
